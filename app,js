import { globalState } from './state.js';

document.addEventListener('DOMContentLoaded', () => {
    const navButtons = document.querySelectorAll('.nav-btn');
    const views = document.querySelectorAll('.view');

    function navigateTo(targetId) {
        navButtons.forEach(btn => {
            if (btn.dataset.target === targetId) {
                btn.classList.add('active');
            } else {
                btn.classList.remove('active');
            }
        });

        views.forEach(view => {
            if (view.id === targetId) {
                view.classList.add('active');
            } else {
                view.classList.remove('active');
            }
        });
    }

    navButtons.forEach(button => {
        button.addEventListener('click', () => {
            const target = button.dataset.target;
            navigateTo(target);
        });
    });

    // Mostrar datos reales en el Dashboard si existen
    updateDashboardStats();

    // Exponer globalmente
    window.app = { navigateTo };
});

function updateDashboardStats() {
    const sessionsCount = globalState.sessions.length;
    // Aquí actualizaremos los contadores visuales del dashboard dinámicamente en las siguientes fases
    console.log(`Estado cargado correctamente. Sesiones registradas: ${sessionsCount}`);
}
